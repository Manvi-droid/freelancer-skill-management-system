# ==============================================================================
# Freelancer Skill Management System (FSMS) Environment Configuration
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000
NODE_ENV=development

# JWT Secret Key for Session Authentication
JWT_SECRET=super_secret_fsms_free_tier_key_replace_in_production_2026

# Optional: AWS Free Tier Cloud Storage Configuration
# If omitted, FSMS automatically operates in Local Storage mode (zero-cost / offline ready)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_S3_BUCKET=your-fsms-evidence-bucket-name
